# Copy to .env locally. Never commit .env or real credential files.
FIREFLY_ENV=development
FIREFLY_API_TOKEN=replace_with_random_demo_token
FIREFLY_MAX_SECRET_BYTES=4096

# SQLCipher: use a stable randomly generated key; do not rotate casually.
SQLCIPHER_DATABASE_PATH=./data/firefly.db
SQLCIPHER_KEY_B64=replace_with_base64_encoded_random_key

# Akeyless authentication. API key authentication is for POC only.
AKEYLESS_API_URL=https://api.akeyless.io
AKEYLESS_ACCESS_ID=replace_me
AKEYLESS_ACCESS_KEY=replace_me
AKEYLESS_KEY_UPSTASH=replace_me
AKEYLESS_KEY_NEON=replace_me
AKEYLESS_KEY_MONGODB=replace_me
AKEYLESS_KEY_FIREBASE=replace_me
AKEYLESS_KEY_SUPABASE=replace_me

# Upstash Redis
UPSTASH_REDIS_URL=rediss://replace_me

# Neon PostgreSQL
NEON_DATABASE_URL=postgresql://replace_me

# MongoDB Atlas
MONGODB_URI=mongodb+srv://replace_me
MONGODB_DATABASE=firefly
MONGODB_COLLECTION=shares

# Firebase Admin SDK: local path to a service-account JSON, or configured ADC.
# Never commit the service-account JSON.
FIREBASE_PROJECT_ID=replace_me
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
FIRESTORE_COLLECTION=firefly_shares

# Supabase PostgreSQL direct/pooler connection string (choose one supported mode).
SUPABASE_DATABASE_URL=postgresql://replace_me
SUPABASE_SCHEMA=public
SUPABASE_TABLE=firefly_shares
